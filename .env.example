# api-kaianolevine-com — names this service reads. Names only: the values
# live in Doppler (api-kaianolevine-com / dev locally, prd on Railway).
# Run under `doppler run -- …`; do not copy this to .env — nothing reads it.
#
# Uncommented names are required in Doppler's dev config, and
# `uv run check-doppler-keys` checks dev holds every one. Commented names
# are optional: Settings has a default (src/kaianolevine_api/config.py
# holds every one), only production reads them, or the value comes from
# elsewhere.

# Which environment this process is in. Doppler sets it per config
# (development in dev, production in prd); it wins over Railway's injected
# RAILWAY_ENVIRONMENT_NAME, so the two must agree.
# ENVIRONMENT=

# Database. Not in Doppler: Railway references its Postgres service, and a
# local run sets it in the shell, which `doppler run` passes through.
# DATABASE_URL=
# OPS-002. Read only by scripts/apply_migrations.py, which runs before the
# app in the start command. Bind it to a role that owns the schema and keep
# DATABASE_URL's role without DDL, so an application-level compromise cannot
# reshape the schema. Unset locally: the runner falls back to DATABASE_URL
# and logs that the separation is not in effect.
# DATABASE_URL_MIGRATIONS=
# Also read only by scripts/apply_migrations.py: BOOTSTRAP_MIGRATIONS=true
# marks every migration except those named in BOOTSTRAP_EXCLUDE
# (comma-separated filenames) as applied without running them, for adopting
# an existing database. Unset otherwise.
# BOOTSTRAP_MIGRATIONS=
# BOOTSTRAP_EXCLUDE=

# Log level (default INFO), and the timeout for this service's outbound HTTP
# calls in seconds (0 in tests, for fast failure).
# LOGGING_LEVEL=
# HTTP_CLIENT_TIMEOUT_SECS=

# Set by Railway for deploys built from GitHub: the commit GET /version
# reports. Unset locally.
# RAILWAY_GIT_COMMIT_SHA=

# Auth — humans (Clerk session JWTs, verified locally against JWKS)
CLERK_ISSUER=
CLERK_JWKS_URL=
# Multi-issuer form, used instead of the two above when more than one Clerk
# tenant is trusted. JSON array of {issuer, jwks_url}.
# CLERK_ISSUERS=

# Auth — machines (one named key each, ecosystem-standards CD-019).
# external tooling: read from the process environment by
# identity_registry.machine_keys(), not through Settings — the set is derived
# from identity_registry.MACHINES, so it cannot be a fixed list of pydantic
# fields. One variable per declared machine; a machine whose key is blank or
# absent cannot authenticate, and no other machine's key will let it in.
DEEJAY_COG_API_KEY=
TRANSCRIPTION_COG_API_KEY=
EVALUATOR_COG_API_KEY=
WIKI_CURATOR_COG_API_KEY=
WATCHER_COG_API_KEY=
OPS_NOTIFIER_API_KEY=
# Held as GitHub secrets by CI (ci-validator: org-level; ecosystem-standards:
# repo-level). Declared in identity_registry.MACHINES; unset means the
# machine cannot authenticate here.
# CI_VALIDATOR_API_KEY=
# ECOSYSTEM_STANDARDS_API_KEY=
# Production only: db-ops runs only against the production databases, so
# development has no key for it and the machine cannot authenticate there.
# DB_OPS_API_KEY=
# Development only (CD-033). Leave unset in production, where the
# contract-suite machine is declared but must not be able to authenticate.
CONTRACT_SUITE_API_KEY=
# Each machine's <NAME>_API_KEY_PREVIOUS (e.g. DEEJAY_COG_API_KEY_PREVIOUS)
# holds the key being rotated out, accepted beside the current one while a
# rotation overlaps. Unset or blank means there is none.

# CORS: the browser origins allowed to call the API, and the only origins the
# contact form accepts. Unset allows none.
# CORS_ORIGINS=

# Discord notifications
# The fallback webhook URL, used for any channel whose own variable below is
# unset. The /github suffix is added by the service for GitHub payloads, so
# paste the plain URL.
# DISCORD_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL_DEFAULT=
# DISCORD_WEBHOOK_URL_ERRORS=
# DISCORD_WEBHOOK_URL_ACTIVITY=
# DISCORD_WEBHOOK_URL_RUNS=
# Running-list feed toggles and filters (services.activity); see config.py.
# NOTIFY_DATA_CHANGES=
# NOTIFY_FAULTS=
# NOTIFY_MACHINE_CLIENT_ERRORS=
# NOTIFY_SUPPRESSED_TABLES=
# NOTIFY_EXCLUDED_PATHS=
# Which running-list events each environment posts, as JSON: environment
# name to event names (data_changed, fault). An environment with no entry
# posts every event. Defaults in config.py; development leaves out
# data_changed.
# DISCORD_NOTIFY_EVENTS={"production": ["data_changed", "fault"], "development": ["fault"]}
# Shared secret set on the GitHub org ci-status webhook. Unset means
# POST /v1/webhooks/github rejects every delivery.
GITHUB_WEBHOOK_SECRET=
# The secret being rotated out, accepted beside the current one while a
# rotation overlaps. Unset or blank means there is none.
# GITHUB_WEBHOOK_SECRET_PREVIOUS=
# Which GitHub events this service has a policy for. Per-event filtering
# (branch, action) happens in routers.notifications, not here.
# GITHUB_NOTIFY_EVENTS=
# Fallback default branch, used only when a payload omits
# repository.default_branch.
# GITHUB_DEFAULT_BRANCH=

# Signals: detected problems that may become tasks (services/signals.py).
# Production only. A token that may run and re-run Actions workflows in
# SIGNAL_ORGS (actions: write) and nothing more; unset, a failed build
# escalates without a remedy.
GITHUB_ACTIONS_TOKEN=
# SIGNAL_ORGS=
# SIGNAL_CI_BRANCHES=
# SIGNAL_CI_RERUN=
# SIGNAL_CI_ESCALATE_AFTER=
# SIGNAL_RUN_ESCALATE_AFTER=
# SIGNAL_FAULT_ESCALATE_AFTER=
# SIGNAL_FAULT_WINDOW_MINUTES=

# GitHub status board (GET /v1/github/status). Read in this order; unset
# answers 501. Optional TTL override for config_data/github_dashboard.yaml.
# GITHUB_DASHBOARD_TOKEN=
# GH_TOKEN=
# GITHUB_TOKEN=
# GITHUB_DASHBOARD_CACHE_TTL_SECS=

# Cog job queues (services.job_queue) and request metrics (CloudWatch).
# Queue names are derived from the cog and ENVIRONMENT, not configured.
# Unset keys fall back to boto3's default credential chain.
# AWS_REGION=
# EVALUATION_QUEUE_PRODUCER_KEY_ID=
# EVALUATION_QUEUE_PRODUCER_SECRET=

# Contact form (POST /v1/contact) — Brevo + Turnstile.
# BREVO_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
# TURNSTILE_SECRET_KEY=

# Resume proxy (GET /v1/resume) — the fleet's Google service account, as its
# JSON key file (the same value the cogs read).
# GOOGLE_CREDENTIALS_JSON=
# RESUME_FILE_ID=

# WCS Q&A agent (docs/wcs-qa-agent.md): the provider keys, the embedding,
# agent and judge models, the flattener and chunking versions an index was
# built with, the quiet period before an automatic embeddings refresh, and
# the per-request budgets (_DEFAULT is what a request gets, _LIMIT the
# ceiling it is clamped to). WCS_SITE_URL is the site answers link to.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# WCS_QA_EMBEDDING_MODEL=
# WCS_QA_AGENT_MODEL=
# WCS_QA_JUDGE_MODEL=
# WCS_QA_CHUNKING_VERSION=
# WCS_QA_PAGE_FLATTENER_VERSION=
# WCS_QA_REFRESH_DEBOUNCE_SECS=
# WCS_QA_MAX_TOOL_CALLS_DEFAULT=
# WCS_QA_MAX_TOOL_CALLS_LIMIT=
# WCS_QA_MAX_INPUT_TOKENS_DEFAULT=
# WCS_QA_MAX_INPUT_TOKENS_LIMIT=
# WCS_QA_MAX_OUTPUT_TOKENS_DEFAULT=
# WCS_QA_MAX_OUTPUT_TOKENS_LIMIT=
# WCS_SITE_URL=

# Sentry — the shared apis project (also read by api-deejaytools); events
# are told apart by the `service` tag. Unset turns Sentry off.
# SENTRY_DSN_APIS=

# Spotify refresh-token renewal (services/spotify_token.py). All optional:
# with any unset, /v1/spotify/authorize answers 503 and no reminders are sent.
# The app credentials are deejay-cog's, from the same shared config.
# SPOTIPY_CLIENT_ID=
# SPOTIPY_CLIENT_SECRET=
# The Spotify user ID the renewed token must belong to.
# SPOTIFY_OWNER_USER_ID=
# Links are built from KAIANO_API_BASE_URL (_DEV outside production);
# {KAIANO_API_BASE_URL}/v1/spotify/callback must be a redirect URI in the
# Spotify dashboard.
# Doppler service token with write access to spotify / prd, the config that
# holds SPOTIPY_REFRESH_TOKEN and _ISSUED_AT and nothing else (prd only).
# DOPPLER_SPOTIFY_WRITE_TOKEN=
# SPOTIFY_DOPPLER_PROJECT=
# SPOTIFY_DOPPLER_CONFIG=
# SPOTIFY_TOKEN_CHECK_INTERVAL_SECS=
